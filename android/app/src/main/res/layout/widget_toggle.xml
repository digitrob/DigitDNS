<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_toggle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_status_title"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#94A3B8" />

    <TextView
        android:id="@+id/widget_toggle_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_toggle_off"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF4655" />

    <TextView
        android:id="@+id/widget_toggle_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_toggle_open"
        android:textSize="10sp"
        android:textColor="#00F0FF" />
</LinearLayout>
