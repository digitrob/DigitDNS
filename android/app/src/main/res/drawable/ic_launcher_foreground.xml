<?xml version="1.0" encoding="utf-8"?>
<!-- The artwork carries the whole icon: it is drawn full-bleed in the
     background layer, so the launcher's mask crops it to the inner 72dp and
     the emblem fills the tile edge to edge. This layer exists only because the
     adaptive-icon schema expects one, and it deliberately draws nothing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:fillAlpha="0"
        android:pathData="M0,0h108v108h-108z" />
</vector>
