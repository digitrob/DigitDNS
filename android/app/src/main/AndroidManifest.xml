<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DigitDnsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DigitDNS"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <!-- The launcher entry is an activity-alias so the operator can choose a
             colour or grayscale home-screen icon. Only one alias is enabled at a
             time; MainActivity itself stays enabled and carries no launcher
             filter. The aliases are enabled/disabled at runtime by
             core/branding/LauncherIcon.kt. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DigitDNS" />

        <activity-alias
            android:name="${applicationId}.LauncherColor"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:theme="@style/Theme.DigitDNS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="${applicationId}.LauncherGrayscale"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gray"
            android:roundIcon="@mipmap/ic_launcher_gray_round"
            android:label="@string/app_name"
            android:theme="@style/Theme.DigitDNS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Share generated .mobileconfig files with other apps (mail, files, etc.). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widgets. The receivers must be declared for Android to offer
             them in the widget picker; each provider owns one appwidget-provider XML
             and renders through RemoteViews. -->
        <receiver
            android:name=".core.widget.DigitDnsStatusWidgetProvider"
            android:exported="false"
            android:label="@string/widget_status_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/digitdns_status_widget_info" />
        </receiver>

        <receiver
            android:name=".core.widget.DigitDnsToggleWidgetProvider"
            android:exported="false"
            android:label="@string/widget_toggle_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/digitdns_toggle_widget_info" />
        </receiver>

        <!-- Holds the authenticated SSE stream open and raises a local notification
             on events (quota, expiry, security). This is the (a) transport chosen for
             v1: no FCM, no Google dependency, no server change — the same
             /api/v3/events/stream the panel subscribes to. -->
        <service
            android:name=".core.notifications.LiveStreamService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Quick Settings toggle for ad blocking. The system binds this service,
             so it must be exported and guarded by the signature permission. -->
        <service
            android:name=".core.quicktile.FilteringTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_filtering"
            android:label="@string/tile_filtering"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

    </application>
</manifest>
